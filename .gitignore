# Environment and secrets
.env
.env.*
!.env.example

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
rag/.cache_*.pkl

# Out directory, temporary sandboxes, and logs
_out/
d2d/eval/_*
*.log
*.err
*.pid
_setup/*.log
_setup/*.err
_setup/*.pid

# Big deliverables / binary documents / application files
*.zip
*.docx
*.exe
delivery/*.pdf
/*.pdf
!d2d/parsed/**/*.pdf

# Corpus (PDF files with copyright/licensing restrictions)
corpus/
data/eval/
